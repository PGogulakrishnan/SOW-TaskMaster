# ─────────────────────────────────────────────────────────────────────
# SOW-TaskMaster Environment Configuration
# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and configure Gemini access. Two options:
#
# OPTION A - Gemini Enterprise / Vertex AI with your GCP project:
#    1. Authenticate locally:  gcloud auth application-default login
#    2. Set the three variables below
#
# OPTION B - Gemini Developer API key (no GCP project):
#    Get a free key from https://aistudio.google.com/app/apikey
#    and set GEMINI_API_KEY

# ── Option A: Gemini Enterprise / Vertex AI (GCP project) ────────────
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=my-agent-learning-project-01
GOOGLE_CLOUD_LOCATION=us-central1

# ── Option B: Gemini Developer API key ───────────────────────────────
# GEMINI_API_KEY=your_actual_gemini_api_key_here

# ── Gemini model to use ──────────────────────────────────────────────
# gemini-2.5-flash is the newest Flash served on Vertex us-central1
GEMINI_MODEL=gemini-2.5-flash

# ── Optional: force LLM mode (auto | true | false) ───────────────────
# USE_REAL_LLM=auto